# Environment variables example

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/zimtrades?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_secure_random_value

# OAuth (Google/Facebook) - create apps and paste credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Stripe (test)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Agora
AGORA_APP_ID=
AGORA_APP_CERT=

# Redis
REDIS_URL=redis://redis:6379

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

