// Prisma schema for NextAuth + application models
// Run: pnpm prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth recommended models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? 
  access_token       String? 
  expires_at         Int? 
  token_type         String? 
  scope              String? 
  id_token           String? 
  session_state      String?

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               Role      @default(BUYER)
  createdAt          DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  subscriptions      Subscription[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  location    String?
  ratingAvg   Float    @default(0)
  completedJobs Int    @default(0)

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  parentId String?
}

model Listing {
  id          String  @id @default(cuid())
  sellerId    String
  title       String
  description String
  type        ListingType
  priceCents  Int
  currency    String @default("USD")
  quantity    Int    @default(1)
  published   Boolean @default(false)
  createdAt   DateTime @default(now())

  seller      User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

enum ListingType {
  PHYSICAL
  DIGITAL
  SERVICE
  GIG
  JOB
}

model Review {
  id        String @id @default(cuid())
  fromUserId String
  toUserId  String
  rating    Int
  text      String?
  listingId String?
  createdAt DateTime @default(now())
}

model Transaction {
  id                  String @id @default(cuid())
  buyerId             String
  sellerId            String
  listingId           String?
  amountCents         Int
  feeCents            Int
  stripePaymentIntent String?
  status              TransactionStatus @default(PENDING)
  createdAt           DateTime @default(now())
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  REFUNDED
}

model Subscription {
  id                    String @id @default(cuid())
  userId                String
  stripeCustomerId      String
  stripeSubscriptionId  String @unique
  plan                  String
  status                String
  currentPeriodEnd      DateTime?
  createdAt             DateTime @default(now())

  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  BUYER
  SELLER
  ADMIN
}
